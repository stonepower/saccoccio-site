{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Configuration de premier niveau : développement local uniquement
	// (`npm run dev`). Ne jamais déployer sans `--env` (voir CLAUDE.md).
	"name": "saccoccio-local",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-11-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"vars": {
		"SITE_ENV": "development",
		"EMDASH_ADMIN_ENABLED": "true",
		// Formulaire de contact (docs/formulaire-contact.md) : messages en D1.
		"CONTACT_MODE": "store",
		"CONTACT_TO": "saccoccio.tirand.bondil.perrot@notaires.fr",
		"CONTACT_FROM": "formulaire@saccoccio-et-associes-manosque-notaires.fr",
		// Clé de test Turnstile « always passes » (publique).
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "saccoccio-db-staging",
			"database_id": "cc9d552e-65cf-46b6-af5c-e98426505cc4",
			"migrations_dir": "migrations",
		},
	],
	"kv_namespaces": [{ "binding": "CACHE", "id": "27394cd344784462a26ec2a090b66f37" }],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "saccoccio-media-staging" }],
	"observability": { "enabled": true },

	"env": {
		"staging": {
			"name": "saccoccio-staging",
			"workers_dev": true,
			"preview_urls": false,
			// Aucune route de domaine pour l'instant.
			"vars": {
				"SITE_ENV": "staging",
				// Back-office EmDash fermé (404 sur /_emdash/*).
				"EMDASH_ADMIN_ENABLED": "false",
				// Formulaire de contact : messages stockés en D1 (purgés à 30 jours),
				// aucun e-mail. Voir docs/formulaire-contact.md.
				"CONTACT_MODE": "store",
				"CONTACT_TO": "saccoccio.tirand.bondil.perrot@notaires.fr",
				"CONTACT_FROM": "formulaire@saccoccio-et-associes-manosque-notaires.fr",
				// Clé publique Turnstile : clé de test « always passes » tant que le
				// widget n'est pas créé (secret TURNSTILE_SECRET_KEY absent).
				"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "saccoccio-db-staging",
					"database_id": "cc9d552e-65cf-46b6-af5c-e98426505cc4",
					"migrations_dir": "migrations",
				},
			],
			"kv_namespaces": [{ "binding": "CACHE", "id": "27394cd344784462a26ec2a090b66f37" }],
			"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "saccoccio-media-staging" }],
		},
		"production": {
			"name": "saccoccio-prod",
			"workers_dev": true,
			"preview_urls": false,
			// Aucune route de domaine pour l'instant.
			"vars": {
				"SITE_ENV": "production",
				// Back-office EmDash fermé (404 sur /_emdash/*).
				"EMDASH_ADMIN_ENABLED": "false",
				// Formulaire de contact : envoi par e-mail (Email Routing). Tant que le
				// binding CONTACT_EMAIL n'est pas déclaré (DNS pas encore chez
				// Cloudflare), le formulaire répond « envoi impossible » avec le
				// téléphone de l'étude. Voir docs/formulaire-contact.md.
				"CONTACT_MODE": "email",
				"CONTACT_TO": "saccoccio.tirand.bondil.perrot@notaires.fr",
				"CONTACT_FROM": "formulaire@saccoccio-et-associes-manosque-notaires.fr",
				// Clé publique Turnstile : À REMPLACER par la clé du widget de
				// production (et définir le secret TURNSTILE_SECRET_KEY).
				"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "saccoccio-db-prod",
					"database_id": "32fd88c5-38e1-4498-97bc-661dd4c1a3f6",
					"migrations_dir": "migrations",
				},
			],
			"kv_namespaces": [{ "binding": "CACHE", "id": "e42be39228ab49478e2f6c2c593e62d2" }],
			"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "saccoccio-media-prod" }],
		},
	},
}
