---
/**
 * Carrousel du bandeau, sans JavaScript : les photos s'enchaînent en fondu
 * par une animation CSS (6 s par photo), qui se met en pause au survol et
 * s'arrête sur la première photo si l'utilisateur limite les animations.
 * Les puces suivent l'animation ; elles sont décoratives (non cliquables).
 */
import { BANDEAU } from "../data/site";

const DUREE_PHOTO = 6; // secondes
const total = BANDEAU.length * DUREE_PHOTO;
// Décalage négatif de chaque photo : au chargement, la première est déjà
// affichée (fin de son fondu d'entrée, à 4 % du cycle) et les autres attendent.
const decalage = (i: number) => `${(i * DUREE_PHOTO - total * 0.04 - total).toFixed(2)}s`;
---

<section class="carrousel" aria-label="Photos de l'étude et de la région" style={`--total: ${total}s`}>
	<ul class="carrousel-photos">
		{
			BANDEAU.map((photo, i) => (
				<li style={`--decalage: ${decalage(i)}`}>
					<img
						src={photo.src}
						alt={photo.alt}
						width={photo.width}
						height={photo.height}
						loading={i === 0 ? "eager" : "lazy"}
						fetchpriority={i === 0 ? "high" : "auto"}
						decoding="async"
					/>
				</li>
			))
		}
	</ul>
	<ol class="carrousel-puces" aria-hidden="true">
		{BANDEAU.map((_, i) => <li style={`--decalage: ${decalage(i)}`} />)}
	</ol>
</section>

<style>
	.carrousel {
		position: relative;
		overflow: hidden;
		background: var(--c-pied);
	}
	.carrousel-photos {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
		aspect-ratio: 950 / 269;
	}
	.carrousel-photos li {
		position: relative;
		grid-area: 1 / 1;
		opacity: 0;
		animation: fondu var(--total) var(--decalage) infinite;
	}
	.carrousel-photos li:first-child {
		opacity: 1;
	}
	.carrousel-photos img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.carrousel:hover li {
		animation-play-state: paused;
	}

	/*
	 * Chaque photo : fondu d'entrée, affichage, fondu de sortie, puis invisible
	 * jusqu'au cycle suivant. Les clés sont exprimées en part du cycle complet
	 * et supposent 5 photos (20 % chacune) : à adapter si BANDEAU change.
	 */
	@keyframes fondu {
		0% {
			opacity: 0;
		}
		4% {
			opacity: 1;
		}
		20% {
			opacity: 1;
		}
		24% {
			opacity: 0;
		}
		100% {
			opacity: 0;
		}
	}

	.carrousel-puces {
		position: absolute;
		bottom: 25px;
		left: 50%;
		display: flex;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		transform: translateX(-50%);
	}
	.carrousel-puces li {
		width: 12px;
		height: 12px;
		margin: 5px 6px;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.5);
		animation: puce var(--total) var(--decalage) infinite;
	}
	.carrousel:hover .carrousel-puces li {
		animation-play-state: paused;
	}
	@keyframes puce {
		0%,
		20% {
			background: #fff;
			transform: scale(1.35);
		}
		22%,
		100% {
			background: rgb(255 255 255 / 0.5);
			transform: none;
		}
	}

	@media (max-width: 767px) {
		.carrousel-puces {
			bottom: 15px;
		}
		.carrousel-puces li {
			width: 9px;
			height: 9px;
			margin: 3px 4px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.carrousel-photos li,
		.carrousel-puces li {
			animation: none !important;
		}
		.carrousel-puces {
			display: none;
		}
	}
</style>
