---
/**
 * Carte d'une annonce immobilière (liste des annonces). La photo reste
 * hébergée chez Immonot : on reçoit son URL telle quelle.
 */
interface Props {
	href: string;
	type: string;
	resume: string;
	prix: string;
	photo: string;
	photoAlt: string;
}

const { href, type, resume, prix, photo, photoAlt } = Astro.props;
---

<article class="annonce">
	<a class="annonce-photo" href={href} tabindex="-1" aria-hidden="true">
		<img src={photo} alt={photoAlt} loading="lazy" decoding="async" />
	</a>
	<div class="annonce-corps">
		<h3><a href={href}>{type}</a></h3>
		<p class="annonce-resume"><a href={href}>{resume}</a></p>
		<p class="annonce-prix">{prix}</p>
	</div>
</article>

<style>
	.annonce {
		display: grid;
		margin-bottom: 38px;
		background: var(--c-blanc);
		font-family: var(--f-menu);
	}
	.annonce-photo {
		display: block;
		height: 230px;
		overflow: hidden;
	}
	.annonce-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.annonce-corps {
		display: flex;
		flex-direction: column;
		padding: 25px 15px 17px;
	}
	.annonce h3 {
		margin: 0 20px 32px;
		font-family: var(--f-menu);
		font-size: 36px;
		font-weight: 400;
		line-height: 1.1;
	}
	.annonce h3 a {
		color: var(--c-titre);
	}
	.annonce-resume {
		flex: 1;
		margin: 0 20px 20px;
		font-size: 13px;
		line-height: 1.5;
	}
	.annonce-prix {
		margin: 0;
		padding: 5px 10px;
		border-top: 1px solid var(--c-gris);
		background: var(--c-bordeaux);
		color: var(--c-blanc);
		font-size: 13px;
		font-weight: 700;
		text-align: center;
	}
	@media (min-width: 992px) {
		.annonce {
			grid-template-columns: 1fr 1fr;
			min-height: 430px;
		}
		.annonce-photo {
			height: auto;
		}
	}
</style>
