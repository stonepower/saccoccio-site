---
/**
 * En-tête commun : bandeau bordeaux (logos, raison sociale, notaires) et
 * menu blanc centré, avec menu « burger » sous 768 px.
 */
import { ETUDE, NAVIGATION } from "../data/site";

const chemin = Astro.url.pathname;
const estActif = (href: string) => {
	const base = href.split("#")[0] ?? href;
	return base !== "/" && chemin.startsWith(base);
};
---

<header class="entete">
	<div class="bandeau">
		<div class="conteneur bandeau-logos">
			<div class="bandeau-cote">
				<img
					src="/images/logo-notaires-de-france.webp"
					alt="Notaires de France"
					width="64"
					height="60"
				/>
			</div>
			<div class="bandeau-centre">
				<a href="/" aria-label={`${ETUDE.nom}, notaires : accueil`}>
					<img
						src="/images/logo-saccoccio.webp"
						alt="Saccoccio & Associés, notaires à Manosque"
						width="169"
						height="87"
					/>
				</a>
			</div>
			<div class="bandeau-cote bandeau-droite">
				<img src="/images/logo-notaires-du-sud.webp" alt="Notaires du Sud" width="69" height="60" />
			</div>
		</div>
		<p class="conteneur bandeau-texte">
			<b>{ETUDE.raisonSociale}</b><br />
			{ETUDE.notaires.join(" - ")}
		</p>
	</div>

	<nav class="menu" aria-label="Menu principal" data-menu>
		<div class="conteneur menu-barre">
			<button
				type="button"
				class="burger"
				aria-expanded="false"
				aria-controls="menu-liste"
				hidden
				data-burger
			>
				<span class="sr-only">Ouvrir le menu</span>
				<span class="burger-barre" aria-hidden="true"></span>
				<span class="burger-barre" aria-hidden="true"></span>
				<span class="burger-barre" aria-hidden="true"></span>
			</button>
			<ul class="menu-liste" id="menu-liste">
				{
					NAVIGATION.map((item) => (
						<li class:list={["menu-item", { "a-sous-menu": item.children }]}>
							<a
								href={item.href}
								class="menu-lien"
								aria-current={estActif(item.href) ? "page" : undefined}
							>
								{item.label}
							</a>
							{item.children && (
								<ul class="sous-menu">
									{item.children.map((enfant) => (
										<li>
											<a href={enfant.href}>{enfant.label}</a>
										</li>
									))}
								</ul>
							)}
						</li>
					))
				}
			</ul>
		</div>
	</nav>
</header>

<script>
	// Menu mobile : sans JavaScript, le menu reste simplement déplié.
	const menu = document.querySelector<HTMLElement>("[data-menu]");
	const bouton = document.querySelector<HTMLButtonElement>("[data-burger]");
	if (menu && bouton) {
		const libelle = bouton.querySelector(".sr-only");
		const basculer = (ouvert: boolean) => {
			menu.dataset.replie = String(!ouvert);
			bouton.setAttribute("aria-expanded", String(ouvert));
			if (libelle) libelle.textContent = ouvert ? "Fermer le menu" : "Ouvrir le menu";
		};
		bouton.hidden = false;
		basculer(false);
		bouton.addEventListener("click", () => basculer(menu.dataset.replie === "true"));
		menu.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && menu.dataset.replie === "false") {
				basculer(false);
				bouton.focus();
			}
		});
	}
</script>

<style>
	/* ---------- Bandeau bordeaux ---------- */
	.bandeau {
		padding: 5px 0 0;
		background: var(--c-bandeau);
		color: var(--c-blanc);
	}
	.bandeau-logos {
		display: flex;
		align-items: center;
	}
	.bandeau-cote {
		flex: 1;
	}
	.bandeau-droite {
		text-align: right;
	}
	.bandeau-cote img {
		max-height: 60px;
		width: auto;
	}
	.bandeau-centre {
		flex: 2;
		text-align: center;
	}
	.bandeau-texte {
		margin: 0 auto;
		text-align: center;
	}

	/* ---------- Menu ---------- */
	.menu {
		position: relative;
		z-index: 20;
		min-height: 80px;
		background: var(--c-blanc);
		box-shadow: 0 0 5px rgb(0 0 0 / 0.5);
	}
	.menu-liste {
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--f-menu);
		font-weight: 700;
	}
	.menu-lien {
		display: block;
		color: var(--c-menu);
		text-transform: uppercase;
	}
	.menu-lien:hover,
	.menu-lien:focus-visible,
	.menu-lien[aria-current="page"],
	.menu-item:hover > .menu-lien {
		color: var(--c-bordeaux);
		text-decoration: none;
	}
	.sous-menu {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.sous-menu a {
		display: block;
	}

	/* Bureau et tablette : menu horizontal centré, sous-menus déroulants */
	@media (min-width: 768px) {
		.burger {
			display: none;
		}
		.menu-liste {
			display: flex;
			justify-content: center;
			font-size: 18.2px;
		}
		.menu-item {
			position: relative;
		}
		.menu-lien {
			padding: 30px 20px;
			line-height: 20px;
		}
		.sous-menu {
			position: absolute;
			top: 100%;
			left: 0;
			min-width: 220px;
			padding: 10px 20px;
			background: var(--c-pied);
			box-shadow: 0 6px 12px rgb(0 0 0 / 0.176);
			text-align: left;
			opacity: 0;
			visibility: hidden;
			transform: translateY(10px);
			transition:
				opacity 0.2s,
				transform 0.2s,
				visibility 0.2s;
		}
		.menu-item:hover > .sous-menu,
		.menu-item:focus-within > .sous-menu {
			opacity: 1;
			visibility: visible;
			transform: none;
		}
		.sous-menu a {
			padding: 12px 15px;
			color: var(--c-blanc);
			font-size: 16px;
			font-weight: 400;
			line-height: 1.3;
			white-space: nowrap;
		}
		.sous-menu li + li a {
			border-top: 1px solid #222;
		}
		.sous-menu a:hover,
		.sous-menu a:focus-visible {
			background: var(--c-bordeaux);
			text-decoration: none;
		}
	}

	/* Mobile : menu « burger » */
	@media (max-width: 767px) {
		.bandeau-texte {
			padding-bottom: 5px;
			font-size: 13px;
			line-height: 1.6;
		}
		.menu-barre {
			display: flex;
			flex-direction: column;
		}
		.burger {
			align-self: flex-end;
			display: flex;
			flex-direction: column;
			gap: 4px;
			margin: 23px 0;
			padding: 9px 10px;
			border: 1px solid var(--c-bordure);
			border-radius: 4px;
			background: transparent;
			cursor: pointer;
		}
		.burger[hidden] {
			display: none;
		}
		.burger:hover,
		.burger:focus-visible {
			background: var(--c-bordure);
		}
		.burger-barre {
			display: block;
			width: 22px;
			height: 2px;
			border-radius: 1px;
			background: #888;
		}
		.menu[data-replie="true"] .menu-liste {
			display: none;
		}
		.menu-liste {
			padding: 0 0 10px;
			border-top: 1px solid var(--c-gris);
			font-size: 16px;
		}
		.menu-lien {
			padding: 12px 0;
			line-height: 20px;
		}
		.sous-menu {
			padding: 0 0 8px 15px;
		}
		.sous-menu a {
			padding: 6px 0;
			color: var(--c-menu);
			font-weight: 400;
			font-size: 15px;
			line-height: 1.4;
		}
	}
</style>
