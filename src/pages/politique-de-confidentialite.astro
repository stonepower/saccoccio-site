---
/**
 * Politique de confidentialité du formulaire de contact (prérendue).
 * Texte court et factuel, À VALIDER PAR L'ÉTUDE avant la mise en production.
 */
import { EMAIL_ETUDE, TELEPHONE_ETUDE } from "../data/contact";
import { ETUDE } from "../data/site";
import Contenu from "../layouts/Contenu.astro";
import { CONSERVATION_JOURS } from "../lib/contact";

export const prerender = true;
---

<Contenu
	title="Politique de confidentialité – Saccoccio & Associés"
	description="Données du formulaire de contact de l'office notarial Saccoccio & Associés : finalité, destinataire, durée de conservation et vos droits."
	h1="Politique de confidentialité"
	ariane={[{ label: "Politique de confidentialité" }]}
>
	<section class="contenu-section">
		<div class="conteneur">
			<div class="contenu-texte">
				<p class="a-valider"><strong>Texte à valider par l'étude.</strong></p>

				<h2>Responsable du traitement</h2>
				<p>
					{ETUDE.raisonSociale} ({ETUDE.nom}), office notarial, 29 Avenue Jean Giono - B.P. 103, 04100
					MANOSQUE.
				</p>

				<h2>Données concernées et finalité</h2>
				<p>
					Le formulaire de contact recueille votre nom, votre adresse e-mail, votre téléphone (facultatif), la
					personne ou le service que vous souhaitez joindre et votre message. Ces informations servent uniquement à
					répondre à votre demande. Elles ne sont ni revendues, ni utilisées à des fins commerciales.
				</p>
				<p>
					Le traitement repose sur votre consentement, donné en cochant la case du formulaire. Sans ces informations,
					l'étude ne peut pas vous répondre.
				</p>

				<h2>Destinataire</h2>
				<p>
					Votre message est transmis par e-mail à l'étude, seule destinataire. Le site est hébergé par Cloudflare,
					qui achemine le message et fournit la vérification anti-spam (Cloudflare Turnstile) ; Cloudflare agit pour
					le compte de l'étude et n'utilise pas ces données pour son propre compte. Le site n'utilise aucun outil de
					mesure d'audience ni aucun traceur publicitaire.
				</p>

				<h2>Durée de conservation</h2>
				<p>
					Le site ne conserve pas votre message une fois transmis. Si le message doit être mis en attente (par
					exemple pendant une opération technique), il est supprimé automatiquement au plus tard {CONSERVATION_JOURS}&nbsp;jours
					après son envoi. Dans la messagerie de l'étude, votre message est conservé le temps nécessaire au
					traitement de votre demande puis, le cas échéant, pendant la durée du dossier auquel il se rattache.
				</p>

				<h2>Vos droits</h2>
				<p>
					Vous pouvez demander l'accès à vos données, leur rectification ou leur effacement, en limiter le
					traitement, vous y opposer et retirer votre consentement à tout moment. Écrivez à l'étude à
					<a href={`mailto:${EMAIL_ETUDE}`}>{EMAIL_ETUDE}</a>, par courrier à l'adresse ci-dessus, ou appelez le {TELEPHONE_ETUDE}.
				</p>
				<p>
					Si vous estimez que vos droits ne sont pas respectés, vous pouvez adresser une réclamation à la CNIL
					(<a href="https://www.cnil.fr" target="_blank" rel="noopener">www.cnil.fr</a>).
				</p>
			</div>
		</div>
	</section>
</Contenu>

<style>
	.a-valider {
		padding: 10px 15px;
		border-left: 4px solid var(--c-bordeaux);
		background: var(--c-blanc);
	}
</style>
